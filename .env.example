# ─────────────────────────────────────────────────────
#  Student Housing Finder — Environment Variables
#  Copy this file to .env and fill in your values
#  On PythonAnywhere: set these in the WSGI file directly
# ─────────────────────────────────────────────────────

# REQUIRED — generate a strong key at https://djecrety.ir
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production (PythonAnywhere)
# Set to True only for local development
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts
# Example for PythonAnywhere:
DJANGO_ALLOWED_HOSTS=Afanwi.pythonanywhere.com

# ─── Email (optional — for password reset) ───────────
# Leave as console backend if you don't have SMTP yet
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@studenthousing.com
